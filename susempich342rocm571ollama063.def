Bootstrap: localimage
From: /ccsopen/home/bishwodahal/containers/olcf_projects/gen243/containers/opensusempich342rocm571.sif

%post

set -e

zypper install -y bzip2 libtool


# installing miniforge and creating a conda environment for pytorch
# everything after this is being done within the scope of the conda environment
# so make sure the conda environment is activated in your run before you do any
# actual work
wget "https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-$(uname)-$(uname -m).sh"
bash Miniforge3-$(uname)-$(uname -m).sh -b -p /opt/miniforge
rm Miniforge3-$(uname)-$(uname -m).sh
source /opt/miniforge/bin/activate


# downloading ollama pre-released model
wget https://github.com/ollama/ollama/releases/download/v0.6.3-rc0/ollama-linux-amd64.tgz

# extracting ollama
tar -xzvf ollama-linux-amd64.tgz

# start ollama after extracting
./bin/ollama serve&

# download astrollama
./bin/ollama pull hf.co/UniverseTBD/astrollama.gguf:latest

# installing ollama via pip to use it in python
pip install ollama



# install mpi4py
MPICC="mpicc -shared" pip install --no-cache-dir --no-binary=mpi4py mpi4py

